#!/usr/bin/env bash
set -e

SESSION="ansiblecraft"
PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Attach to existing session if it exists
if tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux attach-session -t "$SESSION"
fi

# Create new session with nvim in the main pane
tmux new-session -d -s "$SESSION" -c "$PROJECT_DIR" -x "$(tput cols)" -y "$(tput lines)"
tmux send-keys -t "$SESSION" 'nvim' C-m

# Split right pane (~33% width) and run claude
tmux split-window -h -t "$SESSION" -c "$PROJECT_DIR" -l '33%'
tmux send-keys -t "$SESSION" 'claude' C-m

# Split right pane vertically and run bin/dev on port 3002
tmux split-window -v -t "$SESSION" -c "$PROJECT_DIR" -l '50%'
tmux send-keys -t "$SESSION" 'PORT=3002 bin/dev' C-m

# Split left pane (nvim) at bottom 1/3 - empty shell
tmux split-window -v -t "$SESSION:.0" -c "$PROJECT_DIR" -l '15%'

# Focus the left (nvim) pane
tmux select-pane -t "$SESSION:.0"

# Attach
exec tmux attach-session -t "$SESSION"
