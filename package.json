{
  "name": "ansible-craft",
  "version": "0.3.0",
  "description": "Claude Code skills for generating production-ready Ansible roles and playbooks",
  "type": "module",
  "files": ["skills", "references", "scripts/install-skills.mjs", "README.md", "LICENSE"],
  "scripts": {
    "postinstall": "node scripts/install-skills.mjs --quiet || true",
    "install-skills": "node scripts/install-skills.mjs",
    "install-skills:project": "node scripts/install-skills.mjs --project",
    "lint": "biome check .",
    "format": "biome format . --write"
  },
  "keywords": [
    "ansible",
    "automation",
    "devops",
    "claude",
    "claude-code",
    "skills",
    "role",
    "playbook"
  ],
  "author": "ansible-craft contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ansible-craft/ansible-craft.git"
  },
  "bugs": {
    "url": "https://github.com/ansible-craft/ansible-craft/issues"
  },
  "homepage": "https://github.com/ansible-craft/ansible-craft#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  }
}
