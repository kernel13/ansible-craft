# inventory.example - Example inventory file
# Copy to 'inventory' and update with your hosts

all:
  children:
    webservers:
      hosts:
        web1.example.com:
          ansible_host: 192.168.1.10
        web2.example.com:
          ansible_host: 192.168.1.11

    databases:
      hosts:
        db1.example.com:
          ansible_host: 192.168.1.20

  vars:
    ansible_user: deploy
    ansible_become: true
    ansible_python_interpreter: /usr/bin/python3
