# inventory.example - Example inventory file for Kubernetes cluster
# Copy to 'inventory' and update with your hosts

all:
  children:
    k8s_control_plane:
      hosts:
        master1.k8s.example.com:
          ansible_host: 192.168.1.10
        master2.k8s.example.com:
          ansible_host: 192.168.1.11
        master3.k8s.example.com:
          ansible_host: 192.168.1.12

    k8s_workers:
      hosts:
        worker1.k8s.example.com:
          ansible_host: 192.168.1.20
        worker2.k8s.example.com:
          ansible_host: 192.168.1.21
        worker3.k8s.example.com:
          ansible_host: 192.168.1.22
        worker4.k8s.example.com:
          ansible_host: 192.168.1.23
        worker5.k8s.example.com:
          ansible_host: 192.168.1.24

  vars:
    ansible_user: deploy
    ansible_become: true
    ansible_python_interpreter: /usr/bin/python3
